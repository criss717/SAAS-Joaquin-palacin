generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  passwordHash    String
  role            Role           @default(USER)
  taskAssignments TaskAssignee[]
}

model Project {
  id        String   @id @default(uuid())
  name      String
  stage     String   @default("Planeación y Diseño")
  createdAt DateTime @default(now())
  startDate DateTime @default(now())
  quantity  Int      @default(1)
  stages    Stage[]
  tasks     Task[]
}

model Task {
  id                 String           @id @default(uuid())
  name               String
  projectId          String
  parentId           String?
  isAssembly         Boolean          @default(false)
  stage              String           @default("Pendiente")
  startDate          DateTime
  endDate            DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  status             TaskStatus       @default(EN_PROCESO)
  progress           Int              @default(0)
  estimatedHours     Float?           @default(8)
  orderIndex         Int              @default(0)
  deliveryDays       Int?             @default(0)
  quantity           Int              @default(1)
  unitEstimatedHours Float?           @default(8)
  catalogOperationId String?
  catalogPartId      String?
  
  // Materiales (Múltiples)
  materials          TaskMaterial[]

  // Deprecated
  materialId               String?
  materialQuantityPerUnit  Float?    @default(0)
  unitTypeId               String?
  material                 Material? @relation("OldTaskMaterial", fields: [materialId], references: [id])
  unitType                 UnitType? @relation("OldTaskUnit", fields: [unitTypeId], references: [id])

  parent             Task?            @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks           Task[]           @relation("SubTasks")
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees          TaskAssignee[]
  successors         TaskDependency[] @relation("PredecessorTasks")
  predecessors       TaskDependency[] @relation("SuccessorTasks")
}

model TaskDependency {
  id            String @id @default(uuid())
  predecessorId String
  successorId   String
  predecessor   Task   @relation("PredecessorTasks", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Task   @relation("SuccessorTasks", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Stage {
  id        String  @id @default(uuid())
  name      String
  color     String  @default("#94a3b8")
  order     Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model MachineCatalog {
  id          String        @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  parts       CatalogPart[]
}

model CatalogPart {
  id             String             @id @default(uuid())
  name           String
  machineId      String
  parentId       String?
  quantity       Int                @default(1)
  preferredStage String?
  deliveryDays   Int?               @default(0)
  estimatedHours Float?             @default(0)
  
  // Materiales (Múltiples)
  materials      CatalogPartMaterial[]

  // Deprecated
  materialId               String?
  materialQuantityPerUnit  Float?    @default(0)
  unitTypeId               String?
  material                 Material? @relation("OldCatalogMaterial", fields: [materialId], references: [id])
  unitType                 UnitType? @relation("OldCatalogUnit", fields: [unitTypeId], references: [id])

  operations     CatalogOperation[]
  machine        MachineCatalog     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  parent         CatalogPart?       @relation("CatalogSubParts", fields: [parentId], references: [id], onDelete: Cascade)
  subParts       CatalogPart[]      @relation("CatalogSubParts")
}

model CatalogOperation {
  id             String      @id @default(uuid())
  name           String
  partId         String
  estimatedHours Float       @default(8)
  orderIndex     Int         @default(0)
  preferredStage String?
  part           CatalogPart @relation(fields: [partId], references: [id], onDelete: Cascade)
}

model WorkSchedule {
  id          String   @id @default(uuid())
  name        String
  validFrom   DateTime
  validUntil  DateTime
  workingDays String   @default("[1,2,3,4,5]")
  shifts      String   @default("[{\"start\": \"08:00\", \"end\": \"14:00\"}, {\"start\": \"16:00\", \"end\": \"18:00\"}]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Holiday {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  endDate   DateTime?
  startDate DateTime
}

enum Role {
  ADMIN
  USER
}

enum TaskStatus {
  APROBADO
  EN_PROCESO
  CAMBIOS_SOLICITADOS
  HECHO
  CANCELADO
}

model CatalogPartMaterial {
  id               String      @id @default(uuid())
  catalogPartId    String
  materialId       String
  quantityPerUnit  Float       @default(0)
  unitTypeId       String?
  
  catalogPart      CatalogPart @relation(fields: [catalogPartId], references: [id], onDelete: Cascade)
  material         Material    @relation(fields: [materialId], references: [id])
  unitType         UnitType?   @relation(fields: [unitTypeId], references: [id])
}

model TaskMaterial {
  id               String      @id @default(uuid())
  taskId           String
  materialId       String
  quantityPerUnit  Float       @default(0)
  unitTypeId       String?
  
  task             Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  material         Material    @relation(fields: [materialId], references: [id])
  unitType         UnitType?   @relation(fields: [unitTypeId], references: [id])
}

model Material {
  id                 String                @id @default(uuid())
  name               String                @unique
  catalogParts       CatalogPart[]         @relation("OldCatalogMaterial")
  tasks              Task[]                @relation("OldTaskMaterial")
  catalogPartLinks   CatalogPartMaterial[]
  taskLinks          TaskMaterial[]
}

model UnitType {
  id                 String                @id @default(uuid())
  name               String                @unique
  catalogParts       CatalogPart[]         @relation("OldCatalogUnit")
  tasks              Task[]                @relation("OldTaskUnit")
  catalogPartLinks   CatalogPartMaterial[]
  taskLinks          TaskMaterial[]
}
